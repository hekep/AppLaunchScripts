# Generated at runtime by workspaces.lua
AppLaunchScripts.spoon/availableWorkspaces.lua
# Avoid sharing personal workspaces
AppLaunchScripts.spoon/workspaces/personal*
AppLaunchScripts.spoon/workspaces/private*
AppLaunchScripts.spoon/workspaces/Private*
# Workspace run logs
logs/
# macOS cruft
.DS_Store
# Slack domain configs (contain personal channel/people names)
AppLaunchScripts.spoon/config/slack/
AppLaunchScripts.spoon/availableSlackComms.lua
# Teams config (contains personal names and email addresses)
AppLaunchScripts.spoon/config/teams/
AppLaunchScripts.spoon/availableTeamsComms.lua
# Discord configs (contain personal server/channel/people names and IDs)
AppLaunchScripts.spoon/config/discord/
AppLaunchScripts.spoon/config/discordDM/
AppLaunchScripts.spoon/availableDiscordComms.lua
# Windows App config (contains personal PC hostnames)
AppLaunchScripts.spoon/config/windowsapp/
AppLaunchScripts.spoon/availableWindowsAppComms.lua
# Claude catalog (contains personal session titles and folders)
AppLaunchScripts.spoon/availableClaudeComms.lua
# Terminal config (commands may contain personal paths and hosts).
# The scripts/ FOLDER ships (so the feature is discoverable) but every
# script inside it is private.
AppLaunchScripts.spoon/config/terminal/*
!AppLaunchScripts.spoon/config/terminal/scripts/
AppLaunchScripts.spoon/config/terminal/scripts/*
!AppLaunchScripts.spoon/config/terminal/scripts/README.md
AppLaunchScripts.spoon/availableTerminalComms.lua
